  "status_coercion": {
    "_note": "Client-facing status projection. Hand-maintained, lockstep-tested: server/handler TestClientStatusCoercionMatchesVectors pins these against the authoritative Go mapping; the checkout, checkout-receiver, and Unity suites assert their implementations against this same table. Reversals collapse to completed (the payment cleared); anything unrecognized fails safe to processing.",
    "mappings": [
      {
        "server": "pending",
        "client": "processing"
      },
      {
        "server": "completed",
        "client": "completed"
      },
      {
        "server": "failed",
        "client": "failed"
      },
      {
        "server": "abandoned",
        "client": "canceled"
      },
      {
        "server": "refunded",
        "client": "completed"
      },
      {
        "server": "chargedback",
        "client": "completed"
      }
    ],
    "unrecognized_fallback": "processing"
  },
